[Unit]
Description=Daily SAP material movement MySQL synchronization
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=dba
Group=dba
WorkingDirectory=/opt/sgb-matsync
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/mysql-table-sync.env
ExecStart=/opt/sgb-matsync/mysql-table-sync sync
TimeoutStartSec=2h
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/sgb-matsync/logs

[Install]
WantedBy=multi-user.target
